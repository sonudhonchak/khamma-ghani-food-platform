# Backend
PORT=4000
NODE_ENV=development
API_CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Authentication - create strong random secrets outside this file
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_ACCESS_TOKEN_TTL="15m"
AUTH_REFRESH_TOKEN_TTL="30d"

# Storage - provider can be selected later
STORAGE_PROVIDER="supabase"
STORAGE_BUCKET="food-images"
STORAGE_PUBLIC_URL=""

# Payments - leave empty until a real provider is connected
PAYMENT_MODE="mock"
PAYMENT_KEY=""
PAYMENT_SECRET=""
