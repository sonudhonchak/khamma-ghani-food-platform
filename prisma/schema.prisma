generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  RESTAURANT_OWNER
  DELIVERY_PARTNER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum RestaurantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum FoodType {
  VEG
  NON_VEG
  EGG
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  NET_BANKING
  WALLET
  COD
}

enum DeliveryStatus {
  AVAILABLE
  ASSIGNED
  ACCEPTED
  AT_RESTAURANT
  PICKED_UP
  ON_THE_WAY
  DELIVERED
}

model User {
  id                 String       @id @default(cuid())
  name               String
  email              String?      @unique
  phone              String?      @unique
  passwordHash       String?
  role               UserRole     @default(CUSTOMER)
  status             UserStatus   @default(ACTIVE)
  profileImage       String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  addresses          Address[]
  carts              Cart[]
  orders             Order[]
  reviews            Review[]
  favorites          Favorite[]
  notifications      Notification[]
  ownedRestaurants   Restaurant[] @relation("RestaurantOwner")
  deliveryProfile    DeliveryPartner?
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  label        String
  name         String
  phone        String
  addressLine  String
  landmark     String?
  city         String
  state        String
  pincode      String
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@index([userId])
}

model Restaurant {
  id             String           @id @default(cuid())
  ownerId        String
  name           String
  slug           String           @unique
  description    String?
  logo           String?
  coverImage     String?
  cuisine        String
  address        String
  city           String
  latitude       Decimal?         @db.Decimal(10, 7)
  longitude      Decimal?         @db.Decimal(10, 7)
  rating         Decimal          @default(0) @db.Decimal(3, 2)
  deliveryTime   Int              @default(30)
  deliveryFee    Decimal          @default(0) @db.Decimal(10, 2)
  minimumOrder   Decimal          @default(0) @db.Decimal(10, 2)
  status         RestaurantStatus @default(PENDING)
  openingTime    String
  closingTime    String
  isAcceptingOrders Boolean       @default(true)
  isBusy         Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  owner          User             @relation("RestaurantOwner", fields: [ownerId], references: [id])
  categories     Category[]
  foods          FoodItem[]
  carts          Cart[]
  orders         Order[]
  reviews        Review[]
  favorites      Favorite[]

  @@index([ownerId])
  @@index([city, status])
}

model Category {
  id           String       @id @default(cuid())
  restaurantId String
  name         String
  image        String?
  sortOrder    Int          @default(0)

  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  foods        FoodItem[]

  @@index([restaurantId, sortOrder])
}

model FoodItem {
  id              String      @id @default(cuid())
  restaurantId    String
  categoryId      String?
  name            String
  slug            String
  description     String?
  price           Decimal     @db.Decimal(10, 2)
  discountedPrice Decimal?    @db.Decimal(10, 2)
  image           String?
  foodType        FoodType
  availability    Boolean     @default(true)
  preparationTime Int         @default(15)
  rating          Decimal     @default(0) @db.Decimal(3, 2)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  restaurant      Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category        Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  options         FoodOption[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  reviews         Review[]
  favorites       Favorite[]

  @@unique([restaurantId, slug])
  @@index([restaurantId, availability])
}

model FoodOption {
  id          String      @id @default(cuid())
  foodItemId  String
  name        String
  isRequired  Boolean     @default(false)
  minSelect   Int         @default(0)
  maxSelect   Int         @default(1)

  foodItem    FoodItem    @relation(fields: [foodItemId], references: [id], onDelete: Cascade)
  choices     FoodOptionChoice[]
}

model FoodOptionChoice {
  id          String     @id @default(cuid())
  optionId    String
  name        String
  price       Decimal    @default(0) @db.Decimal(10, 2)

  option      FoodOption  @relation(fields: [optionId], references: [id], onDelete: Cascade)
}

model Cart {
  id           String      @id @default(cuid())
  userId       String
  restaurantId String
  updatedAt    DateTime    @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id])
  items        CartItem[]

  @@unique([userId])
}

model CartItem {
  id              String   @id @default(cuid())
  cartId          String
  foodItemId      String
  quantity        Int
  selectedOptions Json?
  price           Decimal  @db.Decimal(10, 2)

  cart            Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  foodItem        FoodItem @relation(fields: [foodItemId], references: [id])
}

model Order {
  id                    String          @id @default(cuid())
  orderNumber           String          @unique
  userId                String
  restaurantId          String
  deliveryPartnerId     String?
  addressId             String
  subtotal              Decimal         @db.Decimal(10, 2)
  deliveryFee           Decimal         @db.Decimal(10, 2)
  taxes                 Decimal         @db.Decimal(10, 2)
  discount              Decimal         @db.Decimal(10, 2)
  total                 Decimal         @db.Decimal(10, 2)
  paymentMethod         PaymentMethod
  paymentStatus         PaymentStatus   @default(PENDING)
  orderStatus           OrderStatus     @default(PLACED)
  notes                 String?
  estimatedDeliveryTime Int?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  user                  User            @relation(fields: [userId], references: [id])
  restaurant            Restaurant      @relation(fields: [restaurantId], references: [id])
  deliveryPartner       DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id])
  address               Address         @relation(fields: [addressId], references: [id])
  items                 OrderItem[]
  payment               Payment?
  reviews               Review[]
  notifications         Notification[]

  @@index([userId, createdAt])
  @@index([restaurantId, createdAt])
  @@index([deliveryPartnerId, createdAt])
  @@index([orderStatus])
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  foodItemId      String
  nameSnapshot    String
  priceSnapshot   Decimal  @db.Decimal(10, 2)
  quantity        Int
  selectedOptions Json?

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  foodItem        FoodItem @relation(fields: [foodItemId], references: [id])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  provider          String
  providerPaymentId String?
  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(PENDING)
  rawReference      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique
  percentage      Decimal? @db.Decimal(5, 2)
  flatDiscount    Decimal? @db.Decimal(10, 2)
  minimumOrder    Decimal @default(0) @db.Decimal(10, 2)
  maximumDiscount Decimal? @db.Decimal(10, 2)
  expiresAt       DateTime
  usageLimit      Int?
  perUserLimit    Int      @default(1)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Review {
  id           String      @id @default(cuid())
  userId       String
  orderId      String
  restaurantId String
  foodItemId   String?
  rating       Int
  text         String?
  images       Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user         User        @relation(fields: [userId], references: [id])
  order        Order       @relation(fields: [orderId], references: [id])
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id])
  foodItem     FoodItem?   @relation(fields: [foodItemId], references: [id])

  @@unique([userId, orderId, restaurantId])
  @@index([restaurantId, rating])
}

model Favorite {
  id           String      @id @default(cuid())
  userId       String
  restaurantId String?
  foodItemId   String?
  createdAt    DateTime    @default(now())

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  foodItem     FoodItem?   @relation(fields: [foodItemId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId, foodItemId])
}

model Notification {
  id           String   @id @default(cuid())
  userId       String
  orderId      String?
  title        String
  message      String
  type         String
  readAt       DateTime?
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order        Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model DeliveryPartner {
  id             String         @id @default(cuid())
  userId         String         @unique
  isAvailable    Boolean        @default(false)
  status         DeliveryStatus @default(AVAILABLE)
  vehicleType    String?
  vehicleNumber  String?
  latitude       Decimal?       @db.Decimal(10, 7)
  longitude      Decimal?       @db.Decimal(10, 7)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders         Order[]
}
